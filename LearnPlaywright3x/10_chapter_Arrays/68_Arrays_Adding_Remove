let arr = [1,2,3];
console.log(arr);

//add to END
arr.push(4);
console.log(arr);

//Remove from END
arr.pop();
console.log(arr);

arr.push(5,6);
console.log(arr);

//Add to beginning
arr.unshift(0);
console.log(arr);

//remove from beginning

arr.shift();
console.log(arr);

arr.splice(2,1);
console.log(arr);

arr.splice(2,0,99);
console.log(arr);

arr.splice(1,2,3,4,5);
console.log(arr);

